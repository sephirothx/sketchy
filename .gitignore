# --- Python (backend) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv
venv
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
# SQLite writes two sidecars beside the database in WAL mode, and a third in
# rollback-journal mode. `*.db` matches none of them, which is how a local
# database's write-ahead log came to be tracked: it changes on every run, so it
# dirtied every working tree and was swept into commits by anything using
# `git add -A`.
*.db-shm
*.db-wal
*.db-journal
*.sqlite*

# --- Node / frontend ---
node_modules
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env files ---
.env
.env.*
!.env.example

# --- Editors ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- OS ---
.DS_Store
Thumbs.db

