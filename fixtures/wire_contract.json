  "join_friend_room": {
   "commandClass": "action",
   "payload": {
    "additionalProperties": false,
    "description": "Ask to be seated wherever a friend is, without naming the room.\n\nCarries the same trailing identity fields `JoinRoomPayload` does, so the\nseat is built by exactly the same `resolve_identity` path. What it does not\ncarry is any way to name a room: no code, no id. The server resolves that\nfrom the friend's live seat, which is what keeps a room code a capability\nsomebody was given rather than one they can ask for.\n\n`inviteToken` is present when this answers an invitation. Without one the\ncaller is pulling themselves in, which is held to a stricter rule - see\n`handlers/friends.py`.",
    "properties": {
     "asSpectator": {
      "default": false,
      "title": "Asspectator",
      "type": "boolean"
     },
     "colorblindSafeColors": {
      "default": false,
      "title": "Colorblindsafecolors",
      "type": "boolean"
     },
     "friendUserId": {
      "maxLength": 128,
      "title": "Frienduserid",
      "type": "string"
     },
     "inviteToken": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Invitetoken"
     },
     "nameColor": {
      "anyOf": [
       {
        "pattern": "^#[0-9a-fA-F]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Namecolor"
     },
     "nickname": {
      "default": "Player",
      "maxLength": 16,
      "title": "Nickname",
      "type": "string"
     }
    },
    "required": [
     "friendUserId"
    ],
    "type": "object"
   },
   "silent": false
  },
