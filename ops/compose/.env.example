# Copy to .env beside compose.yaml, fill in, and keep it private:
#
#   cp .env.example .env && chmod 600 .env
#
# .env is ignored by git. Each value goes only to the services that need it
# (compose.yaml names them one by one), so the web process never sees the
# schema owner's or the superuser's password.
#
# Generate every password and secret with
#
#   openssl rand -hex 32
#
# Hex on purpose: the database passwords are written into connection URLs,
# where characters such as @ : / # would have to be percent-encoded.

# --- Compose ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sketchy
# `tunnel` starts cloudflared. Leave it out to run without one (nothing can
# reach the app then, which is what the smoke wants).
COMPOSE_PROFILES=tunnel
# The image to run. `docker compose build` tags its build with this name;
# once #457 publishes images, set it to a digest instead
# (ghcr.io/...@sha256:...).
SKETCHY_IMAGE=sketchy:local

# --- Where state lives --------------------------------------------------------
# Holds postgres/ (the cluster) and snapshots/ (one dump per deploy). On
# UnRaid use a path on the SSD cache pool, not the parity array:
# /mnt/cache/appdata/sketchy, not /mnt/user/... on an array share.
# Create snapshots/ for the app's user before the first start:
#   mkdir -p "$SKETCHY_DATA_DIR/snapshots" && chown 10001:10001 "$SKETCHY_DATA_DIR/snapshots" && chmod 700 "$SKETCHY_DATA_DIR/snapshots"
SKETCHY_DATA_DIR=/mnt/cache/appdata/sketchy

# --- Database passwords -------------------------------------------------------
# Read once, when the cluster is first created. Changing them here later
# changes nothing in the database: use ALTER ROLE ... PASSWORD as well.
POSTGRES_SUPERUSER_PASSWORD=
SKETCHY_OWNER_DB_PASSWORD=
SKETCHY_APP_DB_PASSWORD=
# postgres_exporter's, for the monitoring stack. Optional until then.
SKETCHY_MONITOR_DB_PASSWORD=

# --- The deployment -----------------------------------------------------------
# The address players use. Set it to the final domain before any staff
# account registers a passkey: passkeys are bound to it (#1516).
PUBLIC_BASE_URL=https://sketchy.example.org
# Shown on /privacy and /terms; production refuses to start without it.
CONTACT_ADDRESS=privacy@sketchy.example.org
# Pseudonymises client addresses (README → Accounts). Keep it stable: a new
# one makes every stored address hash unmatched.
IP_HASH_SECRET=
# Bearer token for /metrics. Empty disables scraping.
METRICS_TOKEN=

# --- Mail ---------------------------------------------------------------------
# A relay service: a home connection cannot deliver mail itself. SMTP_FROM
# must be on a domain whose SPF/DKIM records name that relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Sketchy <play@sketchy.example.org>

# --- Cloudflare tunnel --------------------------------------------------------
# From the tunnel's page in the Cloudflare dashboard (Networks → Tunnels →
# the tunnel → Install connector: the long token after `--token`). Its public
# hostname's service is http://app:8000.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional -----------------------------------------------------------------
# The edge network and cloudflared's fixed address on it. The app trusts
# forwarded headers from that one address only. Change both if the subnet
# collides with another network on the host.
# SKETCHY_EDGE_SUBNET=172.31.240.0/24
# SKETCHY_PROXY_IP=172.31.240.10
# Limits. PASSWORD_HASH_WORKERS should not exceed the app's CPUs.
# SKETCHY_APP_CPUS=2
# SKETCHY_APP_MEMORY=2g
# SKETCHY_DB_MEMORY=2g
# SKETCHY_PASSWORD_HASH_WORKERS=1
# SHUTDOWN_DRAIN_SECONDS=30
# The uid/gid the app and the migration run as; snapshots/ must belong to it.
# SKETCHY_UID=10001
# SKETCHY_GID=10001
