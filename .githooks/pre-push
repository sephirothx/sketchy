#!/usr/bin/env bash
# Stop a database, an environment file, or a private key before it leaves the
# machine. CI refuses the same files, but only after the push is already public -
# and for a secret, public is the whole problem.
#
# Hooks are not tracked by git, so this one is opt-in per clone:
#
#   git config core.hooksPath .githooks
#
# git feeds pre-push one line per ref: <local ref> <local sha> <remote ref> <remote sha>,
# and passes the remote's name and URL as arguments.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
status=0

scan() {
  "$root/scripts/check-tracked-artifacts.sh" "$@"
}

# Scope "already published" to the remote actually being pushed to. Bare
# `--remotes` covers every remote at once, which quietly excuses history from
# scanning the moment a second remote exists: commits sitting on a fork's
# tracking refs would be skipped while being sent somewhere that has never seen
# them.
remote_name=${1:-}
remote_url=${2:-}

if [ -z "$remote_name" ] || ! git remote get-url "$remote_name" >/dev/null 2>&1; then
  # git passes a bare URL as the name when the push names no configured remote.
  # If that URL belongs to a remote we do know, use its tracking refs.
  for candidate in $(git remote); do
    if [ "$(git remote get-url "$candidate" 2>/dev/null)" = "$remote_url" ]; then
      remote_name=$candidate
      break
    fi
  done
fi

published=()
if git remote get-url "$remote_name" >/dev/null 2>&1; then
  published=("--remotes=$remote_name")
fi

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # An all-zero local sha is a branch deletion: nothing is being sent.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  # An all-zero remote sha is a branch the remote has never seen, so there is no
  # far end to diff against. Everything not already published to this remote is
  # what the push would add.
  #
  # For a destination we cannot identify at all there are no tracking refs to
  # subtract, and "already on some other remote" is not an answer: a secret
  # sitting in a private fork is exactly what must not reach a public URL
  # unscanned. Scan from the baseline floor instead, the same one CI uses.
  case "$remote_sha" in
    *[!0]*)
      # Clamped, because the ref being pushed to can itself sit at a commit
      # older than the baseline.
      range=("$(scan --floor "$remote_sha")..$local_sha")
      ;;
    *)
      #
      # The floor applies here too, and not only for an unknown destination: a
      # remote that is configured but has no tracking refs yet subtracts
      # nothing, which walks the whole history. That history holds the write-ahead
      # logs from the first incident as well as the database from the second, so
      # an unfloored walk refuses such a push permanently.
      if [ ${#published[@]} -gt 0 ]; then
        # `^baseline` goes before `--not`, which flips the sense of every `^`
        # that follows it - putting the floor after would include the history it
        # is meant to cut off.
        range=("$local_sha" "^$(scan --baseline)" --not "${published[@]}")
      else
        range=("$(scan --baseline)..$local_sha")
      fi
      ;;
  esac

  if ! scan --range "${range[@]}"; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf '\npre-push: refusing to push the files listed above.\n' >&2
fi

exit "$status"
